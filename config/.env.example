SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# bot に指示できる Slack member ID（カンマ区切り）
ALLOWED_USER_IDS=U...
# fb で受けたフィードバックを PR にする（使わないなら空のまま）
# GitHub の fine-grained PAT（このリポジトリだけ、Contents と Pull requests を Read and write）
# commit と PR には Slack の依頼の文とリンクが入るので、private のリポジトリに使う
GITHUB_TOKEN=
# owner/name
GITHUB_REPO=
# 以下は任意（既定値はコメントのとおり）
# CLAUDE_BIN=claude
# CLAUDE_WORK_DIR=runtime/workspace
# CLAUDE_SETTINGS=config/claude-settings.json
# CLAUDE_TIMEOUT_SEC=1800
